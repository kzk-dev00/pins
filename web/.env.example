# .env.local にコピーして使う。本番は Amplify Hosting の環境変数に同じものを設定する

# API Gateway（HTTP API）の URL。`<DEV_API_ID>` は APIGateway の画面で確認する
NEXT_PUBLIC_API_BASE_URL=https://<DEV_API_ID>.execute-api.ap-southeast-2.amazonaws.com

# 地図の初期位置（現在地が取れないとき）。未設定・範囲外なら東京駅
NEXT_PUBLIC_DEFAULT_LAT=35.6812
NEXT_PUBLIC_DEFAULT_LNG=139.7671
NEXT_PUBLIC_DEFAULT_ZOOM=14
