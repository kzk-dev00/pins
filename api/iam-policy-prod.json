{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PinMemoProdTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-2:<ACCOUNT_ID>:table/pin-memo-prod-categories",
        "arn:aws:dynamodb:ap-southeast-2:<ACCOUNT_ID>:table/pin-memo-prod-categories/index/viewKey-index",
        "arn:aws:dynamodb:ap-southeast-2:<ACCOUNT_ID>:table/pin-memo-prod-pins"
      ]
    }
  ]
}
